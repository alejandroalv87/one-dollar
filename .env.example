# ---------------------------------------------------------------------------
# Copy this file to ".env.local" (local dev) or set these in your host's
# environment settings (Netlify / Vercel / Render / Docker).
#
# This build has NO login, so there are only two variables to set.
# ---------------------------------------------------------------------------

# Market data (Financial Modeling Prep). Get a key at
# https://site.financialmodelingprep.com/developer/docs
# The key stays server-side and is never exposed to the browser.
FMP_API_KEY=your-fmp-api-key

# Seconds to cache each data response server-side (keeps you under rate limits
# while staying "live"). 60 is a good default.
DATA_CACHE_TTL=60
